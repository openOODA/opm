// # write_file lock and CAS store
//
// Logline: Place lock and CAS bytes with fs_mkdir and write_file. No shell copies.
//
// Setup: Project root is OODA_FS_WRITEDIR. Missing token is empty root; callers fail closed.
//
// Beats:
//   1. Resolve the write root from EnvCap. No pwd. No HOME.
//   2. mkdir .ooda_modules and cas dirs.
//   3. write_file lock and payload. Fail closed on deny.

pub fn pm_root_abs(env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_FS_WRITEDIR");
    return match r { Ok(s) => s, Err(_) => "" };
}

pub fn pm_mkdir(fr: &FsReadCap, fw: &FsWriteCap, abs: String) -> Bool {
    if path_exists(fr, abs) {
        return true;
    }
    let mk: Result[Void, String] = oo_fs_mkdir(fw, abs);
    if mk.is_ok() {
        return true;
    }
    return path_exists(fr, abs);
}

pub fn pm_mkdir_p(fr: &FsReadCap, fw: &FsWriteCap, abs: String) -> Bool {
    if abs == "" { return false; }
    if path_exists(fr, abs) { return true; }
    let n: Int = chars_len(abs);
    let mut i: Int = 1;
    while i < n {
        if char_at(abs, i) == "/" {
            let prefix: String = str_slice(abs, 0, i);
            if prefix != "" && prefix != "/" {
                if !pm_mkdir(fr, fw, prefix) { return false; }
            }
        }
        i = i + 1;
    }
    return pm_mkdir(fr, fw, abs);
}

pub fn pm_put(fw: &FsWriteCap, abs: String, body: String) -> Bool {
    let wr: Result[Void, String] = write_file(fw, abs, body);
    return wr.is_ok();
}

pub fn pm_ensure_mod(fr: &FsReadCap, fw: &FsWriteCap, root: String) -> Bool {
    if !pm_mkdir(fr, fw, root + "/.ooda_modules") {
        return false;
    }
    return pm_mkdir(fr, fw, root + "/.ooda_modules/cas");
}

pub fn pm_put_lock(fr: &FsReadCap, fw: &FsWriteCap, root: String, lock: String) -> Bool {
    if !pm_ensure_mod(fr, fw, root) {
        return false;
    }
    return pm_put(fw, root + "/.ooda_modules/lock", lock);
}

pub fn pm_put_cas(fr: &FsReadCap, fw: &FsWriteCap, root: String, sha: String, fname: String, body: String) -> Bool {
    if !pm_ensure_mod(fr, fw, root) {
        return false;
    }
    let dir: String = root + "/.ooda_modules/cas/" + sha;
    if !pm_mkdir(fr, fw, dir) {
        return false;
    }
    return pm_put(fw, dir + "/" + fname, body);
}

pub fn pm_put_vendor(fr: &FsReadCap, fw: &FsWriteCap, root: String, fname: String, body: String) -> Bool {
    let dir: String = root + "/vendor";
    if !pm_mkdir(fr, fw, dir) {
        return false;
    }
    return pm_put(fw, dir + "/" + fname, body);
}
