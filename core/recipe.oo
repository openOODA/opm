// # Offline recipe manifest parse
//
// Logline: Read origin, pin, license, and caps from a key=value recipe. No fetch.
//
// Setup: Origins are dir, git, deb, rpm, and appimage. Uses pm_kv. No HTTP.
//
// Beats:
//   1. Accept only the five origin names.
//   2. Git origin needs a hex commit pin. After the name is in the lock, sha256 is required.
//   3. Build a tiny wrapper that names the payload. It does not rewrite a blob.

import "resolve/resolve.oo";
import "lock/v2.oo";

pub fn pm_origin_ok(origin: String) -> Bool {
    if origin == "dir" { return true; }
    if origin == "git" { return true; }
    if origin == "deb" { return true; }
    if origin == "rpm" { return true; }
    if origin == "appimage" { return true; }
    return false;
}

pub fn pm_origin_blob(origin: String) -> Bool {
    if origin == "deb" { return true; }
    if origin == "rpm" { return true; }
    if origin == "appimage" { return true; }
    return false;
}

pub fn pm_recipe_sha_ok(want: String, live: String) -> Bool {
    if want == "" {
        return true;
    }
    return want == live;
}

pub fn pm_recipe_commit_want(man: String) -> String {
    let c: String = pm_kv(man, "commit");
    if c == "" {
        return pm_git_commit(pm_kv(man, "git"));
    }
    return c;
}

fn pm_hex_digit(c: String) -> Bool {
    if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" { return true; }
    if c == "5" || c == "6" || c == "7" || c == "8" || c == "9" { return true; }
    if c == "a" || c == "b" || c == "c" || c == "d" || c == "e" || c == "f" { return true; }
    if c == "A" || c == "B" || c == "C" || c == "D" || c == "E" || c == "F" { return true; }
    return false;
}

pub fn pm_git_commit_pin_ok(commit: String) -> Bool {
    let n: Int = chars_len(commit);
    if n < 7 {
        return false;
    }
    let mut i: Int = 0;
    while i < n {
        if !pm_hex_digit(char_at(commit, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn pm_git_sha_after_lock_ok(name: String, sha: String, lock: String) -> Bool {
    if sha != "" {
        return true;
    }
    if name == "" {
        return false;
    }
    return str_index_of(lock, name + "@") < 0;
}

pub fn pm_recipe_wrap(name: String, sha: String, payload: String) -> String {
    let h: String = "// # Ingest wrapper for " + name + "\n//\n";
    let l: String = "// Logline: Names the pinned CAS payload. Does not rewrite the blob.\n//\n";
    let s: String = "// Setup: Written by opm ingest. Not a program of the payload.\n//\n";
    let b: String = "// Beats:\n//   1. Return the payload file name.\n//   2. Return the content sha256.\n//   3. The blob is unchanged. No ELF rewrite.\n\n";
    let f1: String = "pub fn ingest_payload_file() -> String {\n    return \"" + payload + "\";\n}\n\n";
    let f2: String = "pub fn ingest_cas_id() -> String {\n    return \"" + sha + "\";\n}\n";
    return h + l + s + b + f1 + f2;
}
