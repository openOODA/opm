// # Opm — Anchor for Agents
//
// Logline: OODA Package Manager. Front door for the opm/ dir.
//
// Setup: 9 library subdirs (core, resolve, lock, store, registry,
//        policy, sign, launch, qa) + cli/ = 10 public subdirs.
//        scripts/, docs/, examples/ are non-public siblings.
//        std/ is a local compile pointer to the std repo; OODA_STD is the contract.
//        Each public subdir has its own ANCHOR.oo. No VERSION file.
//
// Beats:
//   1. The 9 library subdirs are: core, resolve, lock, store, registry, policy, sign, launch, qa.
//   2. cli/ has the live subcommand handlers and main.oo. Helpers are not commands.
//   3. qa/ has the break-test drivers that ship with the package.
//   4. scripts/ has build, test, verify, release entry points.
//   5. docs/ has versioning.oot, cli.oot, and ANCHOR.oo.
//   6. examples/ has manifest, recipe, and lockfile samples.
//   7. api_surface=10. Version is the git tag. No VERSION file.
//   8. Unique move: resolve that refuses extra caps. Do not grow commands.

import "core/ANCHOR.oo";
import "resolve/ANCHOR.oo";
import "lock/ANCHOR.oo";
import "store/ANCHOR.oo";
import "registry/ANCHOR.oo";
import "policy/ANCHOR.oo";
import "sign/ANCHOR.oo";
import "launch/ANCHOR.oo";
import "qa/ANCHOR.oo";
import "cli/ANCHOR.oo";
import "scripts/ANCHOR.oo";
import "docs/ANCHOR.oo";
import "examples/ANCHOR.oo";
