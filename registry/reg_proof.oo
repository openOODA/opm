// # Registry origin and minisign proofs
//
// Logline: Drive shipped origin rules. Minisign without OODA_MINISIGN is Err.
//
// Setup: No ../registry. No PATH hunt.
//
// Beats:
//   1. Default origin allows. http and lookalikes deny.
//   2. Relative paths refuse .. and absolute names.
//   3. Missing minisign token or missing files is err, not ok.

import "cli/reg_fetch.oo";
import "reg.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main(fs: &FsReadCap, sys: &ProcessCap, env: &EnvCap) {
    if !pm_reg_origin_ok(pm_reg_default()) { fail("default"); }
    if !pm_reg_origin_ok("https://catalog.openooda.org/") { fail("slash"); }
    if pm_reg_origin_ok("http://catalog.openooda.org") { fail("http"); }
    if pm_reg_origin_ok("https://catalog.openooda.org.evil") { fail("dotevil"); }
    if pm_reg_origin_ok("https://evil.example/catalog.openooda.org") { fail("embed"); }
    if pm_reg_origin_ok("https://catalog.openooda.org/x") { fail("path"); }
    if pm_reg_origin_ok("https://notcatalog.openooda.org") { fail("not"); }
    if pm_reg_origin_ok("https://registry.openooda.org") { fail("old host"); }
    println("origin");
    if !pm_reg_rel_ok("hello/manifest") { fail("rel"); }
    if pm_reg_rel_ok("../evil") { fail("dotdot"); }
    if pm_reg_rel_ok("/abs") { fail("abs"); }
    if pm_reg_rel_ok("https://x") { fail("relurl"); }
    println("rel");
    let pubp: String = pm_reg_pub_path();
    let miss: String = pm_reg_minisign_ok(fs, sys, env, pubp, "no-such-index", "no-such.minisig");
    if miss == "ok" { fail("missing files must not verify"); }
    println("minisign fail-closed");
    println("pm_reg_proof: PASSED");
}
