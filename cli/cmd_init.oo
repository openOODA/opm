// # Product `opm init`
//
// Logline: Write a starter `ooda.pkg` manifest with name, version, deps, caps, license, and signature placeholders.
//
// Setup: Refuse if `ooda.pkg` already exists. Default name is "pkg". Writes under FsWriteCap and OODA_FS_WRITEDIR. No HTTP.
//
// Beats:
//   1. Parse the optional project name from rest[0].
//   2. Refuse bad names and refuse an existing ooda.pkg.
//   3. Build the manifest text and write it via write_file.
//   4. Print text or --json confirmation.

import "argv.oo";
import "slurp.oo";
import "core/name.oo";
import "store/store.oo";

pub fn pm_init_manifest(name: String) -> String {
    return "name=" + name + "\nversion=0.1.0\ndeps=\ncaps=FsRead,FsWrite\nlicense=MIT\npayload=" + name + ".oo\ncommit=\nsha256=\nsig=\n";
}

pub fn run_ooda_pm_init(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let name: String = pm_init_name(args);
    if !pm_name_ok(name) {
        pm_die("init", "refuse name: " + name);
    }
    if pm_slurp(fr, "ooda.pkg") != "" {
        pm_die("init", "ooda.pkg already exists");
    }
    let root: String = pm_root_abs(env);
    if root == "" {
        pm_die("init", "OODA_FS_WRITEDIR required");
    }
    let abs: String = root + "/ooda.pkg";
    let body: String = pm_init_manifest(name);
    if !pm_place(fw, abs, body) {
        pm_die("init", "write failed (path not under OODA_FS_WRITEDIR?)");
    }
    if pm_flag(args, "--json") || pm_flag(args, "-json") {
        println("{\"ok\":true,\"cmd\":\"init\",\"name\":\"" + pm_jesc(name) + "\",\"path\":\"" + pm_jesc(abs) + "\"}");
        return;
    }
    println("opm init: wrote " + abs + " (name=" + name + ", version=0.1.0)");
    let _p: &ProcessCap = proc;
}
