// # opm demo — Walk the seed catalog with progress UX
//
// Logline: Read seed/catalog, then for each package read its
//          manifest and payload. Each step is real I/O against the
//          opm seed tree. The user sees the progress UX in action
//          during an actual opm operation, not synthetic work.
//
// Setup:  Read-only against opm/seed/. Uses FsReadCap. No process
//         spawn, no FsWrite. Delay is a small busy-wait so lines
//         appear in sequence (not synthetic — the I/O itself is real).
//
// Beats:
//   1. Parse flags: --steps N (default 4), --delay ITERATIONS (default 2000000).
//   2. Read seed/catalog and parse each line as name|version|caps|deps|sha.
//   3. For each of the first N packages, emit step_begin/step_ok pairs:
//      read manifest, then read payload, with real bytes read.
//   4. Print final summary via pm_progress_finish.

import "progress.oo";
import "slurp.oo";

fn pm_demo_busy_wait(its: Int) {
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < its {
        acc = (acc * 31 + i) - (acc * 31 + i) / 1000003 * 1000003;
        i = i + 1;
    }
    return;
}

fn pm_demo_opt(args: List[String], name: String) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if chars_len(a) > chars_len(name) {
            if str_slice(a, 0, chars_len(name)) == name {
                if char_at(a, chars_len(name)) == "=" {
                    return str_slice(a, chars_len(name) + 1, chars_len(a));
                }
            }
        }
        i = i + 1;
    }
    return "";
}

fn pm_demo_parse_int(s: String, fallback: Int) -> Int {
    let n: Int = chars_len(s);
    if n == 0 { return fallback; }
    let chars: String = "0123456789";
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        let mut found: Bool = false;
        let mut d: Int = 0;
        while d < 10 {
            if char_at(chars, d) == c { found = true; }
            d = d + 1;
        }
        if !found { return fallback; }
        let mut j: Int = 0;
        while j < 10 {
            if char_at(chars, j) == c { d = j; j = 10; }
            j = j + 1;
        }
        acc = acc * 10 + d;
        i = i + 1;
    }
    return acc;
}

fn pm_demo_first_field(line: String) -> String {
    let n: Int = chars_len(line);
    let mut i: Int = 0;
    while i < n {
        if char_at(line, i) == "|" { return str_slice(line, 0, i); }
        i = i + 1;
    }
    return line;
}

fn pm_demo_count_pkgs(cat: String) -> Int {
    let n: Int = chars_len(cat);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut count: Int = 0;
    while i <= n {
        if i == n || char_at(cat, i) == "\n" {
            if i > start {
                let line: String = str_slice(cat, start, i);
                if pm_demo_first_field(line) != "" {
                    count = count + 1;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return count;
}

fn pm_demo_pkg_at(cat: String, idx: Int) -> String {
    let n: Int = chars_len(cat);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut cur: Int = 0;
    while i <= n {
        if i == n || char_at(cat, i) == "\n" {
            if i > start {
                let line: String = str_slice(cat, start, i);
                if pm_demo_first_field(line) != "" {
                    if cur == idx { return line; }
                    cur = cur + 1;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

pub fn run_ooda_pm_demo(fr: &FsReadCap, env: &EnvCap, args: List[String]) {
    let mut max_steps: Int = 4;
    let mut delay: Int = 2000000;
    let s_opt: String = pm_demo_opt(args, "--steps");
    if s_opt != "" { max_steps = pm_demo_parse_int(s_opt, 4); }
    if max_steps < 1 { max_steps = 1; }
    if max_steps > 9 { max_steps = 9; }
    let d_opt: String = pm_demo_opt(args, "--delay");
    if d_opt != "" { delay = pm_demo_parse_int(d_opt, 2000000); }
    if delay < 0 { delay = 0; }
    if delay > 200000000 { delay = 200000000; }

    let cat: String = pm_slurp(fr, "seed/catalog");
    let total: Int = pm_demo_count_pkgs(cat);
    if total == 0 {
        println("opm demo: no seed/catalog found. Run from the opm repo root.");
        process_exit(1);
    }

    let steps_to_run: Int = max_steps;
    let total_steps: Int = steps_to_run * 2;
    let mut ph: ProgressHandle = pm_progress_new(env, total_steps, "opm demo");
    ph.is_color = true;
    let mut failed: Int = 0;
    let mut i: Int = 0;
    while i < steps_to_run && i < total {
        let line: String = pm_demo_pkg_at(cat, i);
        let pkg: String = pm_demo_first_field(line);

        let name1: String = "read " + pkg + "/manifest";
        pm_progress_step_begin(&mut ph, name1);
        pm_demo_busy_wait(delay);
        let manifest: String = pm_slurp(fr, "seed/" + pkg + "/manifest");
        let man_bytes: Int = chars_len(manifest);
        pm_progress_step_ok(&mut ph, name1, man_bytes.to_string() + " bytes");

        let name2: String = "check " + pkg + " payload";
        pm_progress_step_begin(&mut ph, name2);
        pm_demo_busy_wait(delay);
        let payload: String = pm_slurp(fr, "seed/" + pkg + "/" + pkg + ".oo");
        let pay_bytes: Int = chars_len(payload);
        if pay_bytes == 0 {
            pm_progress_step_warn(&mut ph, name2, "missing payload");
        } else {
            pm_progress_step_ok(&mut ph, name2, pay_bytes.to_string() + " bytes");
        }

        i = i + 1;
    }
    pm_progress_finish(ph);
    if failed > 0 {
        process_exit(1);
    }
}