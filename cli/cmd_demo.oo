// # opm demo — Synthesize a 5-step progress run
//
// Logline: Demonstrate pm_progress end-to-end with synthetic work.
//          The user can run `opm demo` in a plain terminal to see
//          the line-mode animation: spinner on running steps, then
//          status markers on completion. No caps, no I/O.
//
// Setup:  Pure stdio. No process spawn. No FsWrite. The terminal
//         handles redraw. Delay is a busy-wait (no TimeCap) so the
//         animation is visible without changing main.oo's signature.
//
// Beats:
//   1. Parse flags: --steps N (default 5), --delay ITERATIONS (default 8000000).
//   2. Build a 5-step synthetic plan with mixed outcomes.
//   3. Run each step through pm_progress with realistic timing.
//   4. Final summary line via pm_progress_finish.

import "progress.oo";

fn pm_demo_busy_wait(its: Int) {
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < its {
        acc = (acc * 31 + i) - (acc * 31 + i) / 1000003 * 1000003;
        i = i + 1;
    }
    return;
}

fn pm_demo_int_to_str(n: Int) -> String {
    if n == 0 { return "0"; }
    let mut out: String = "";
    let mut v: Int = n;
    while v > 0 {
        let d: Int = v - (v / 10) * 10;
        out = char_at("0123456789", d) + out;
        v = v / 10;
    }
    if n < 0 { return "-" + out; }
    return out;
}

fn pm_demo_flag(args: List[String], name: String) -> Bool {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        if list_get(args, i) == name { return true; }
        i = i + 1;
    }
    return false;
}

fn pm_demo_opt(args: List[String], name: String) -> String {
    let n: Int = list_len(args);
    let mut i: Int = 0;
    while i < n {
        let a: String = list_get(args, i);
        if chars_len(a) > chars_len(name) {
            if str_slice(a, 0, chars_len(name)) == name {
                if char_at(a, chars_len(name)) == "=" {
                    return str_slice(a, chars_len(name) + 1, chars_len(a));
                }
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn run_ooda_pm_demo(env: &EnvCap, args: List[String]) {
    let mut steps: Int = 5;
    let mut delay: Int = 8000000;
    let s_opt: String = pm_demo_opt(args, "--steps");
    if s_opt != "" {
        let sr: Result[Int, String] = parse_int(s_opt);
        if sr.is_ok() { steps = match sr { Ok(n) => n, Err(_) => 5 }; }
    }
    if steps < 1 { steps = 1; }
    if steps > 9 { steps = 9; }
    let d_opt: String = pm_demo_opt(args, "--delay");
    if d_opt != "" {
        let dr: Result[Int, String] = parse_int(d_opt);
        if dr.is_ok() { delay = match dr { Ok(n) => n, Err(_) => 8000000 }; }
    }
    if delay < 0 { delay = 0; }
    if delay > 200000000 { delay = 200000000; }

    let mut ph: ProgressHandle = pm_progress_new(env, steps, "opm demo");
    let mut failed: Int = 0;
    let mut i: Int = 1;
    while i <= steps {
        let name: String = "step-" + pm_demo_int_to_str(i);
        pm_progress_step_begin(&mut ph, name);
        pm_demo_busy_wait(delay);

        if i == 4 && steps >= 4 {
            pm_progress_step_err(&mut ph, name, "forced failure for demo");
            failed = failed + 1;
        } else {
            if i == 3 && steps >= 3 {
                pm_progress_step_warn(&mut ph, name, "size anomaly detected");
            } else {
                pm_progress_step_ok(&mut ph, name, "ok");
            }
        }
        i = i + 1;
    }
    pm_progress_finish(ph);
    if failed > 0 {
        process_exit(1);
    }
}