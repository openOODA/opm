// # Start oodac from opm launch
//
// Logline: Find OODA_COMPILER and run a pinned .oo. No shell. No build flags.
//
// Setup: EnvCap resolves the compiler. ProcessCap starts oodac. Launch is run, not build.
//
// Beats:
//   1. Resolve the compiler via OODA_COMPILER. Refuse a product-CLI basename.
//   2. Exec `oodac run <path>` with argv. No sh -c.
//   3. Missing compiler or missing file is Err.

import "find_compiler.oo";

fn is_product_cli_path(path: String) -> Bool {
    let n: Int = chars_len(path);
    if n == 4 { return path == "ooda"; }
    if n < 5 { return false; }
    return str_slice(path, n - 5, n) == "/ooda";
}

pub fn refuse_cli(proc: &ProcessCap, path: String) {
    if is_product_cli_path(path) {
        println("ERR\tcli\toodac path is the product CLI");
        process_exit(1);
    }
    let r: Result[String, String] = sys_exec(proc, path, "--version");
    if r.is_err() {
        println("ERR\tcli\toodac is not executable");
        process_exit(1);
    }
}

pub fn run_oodac_run(fr: &FsReadCap, proc: &ProcessCap, env: &EnvCap, path: String) {
    let oodac: String = find_oodac(fr, env);
    refuse_cli(proc, oodac);
    if path == "" {
        println("ERR\tcli\tmissing file");
        process_exit(2);
    }
    if !path_exists(fr, path) {
        println("ERR\tcli\tunreadable file: " + path);
        process_exit(2);
    }
    let r: Result[String, String] = sys_exec(proc, oodac, "run", path);
    if r.is_ok() {
        let out_str: String = match r { Ok(s) => s, Err(_) => "" };
        if out_str != "" {
            println(out_str);
        }
        process_exit(0);
    }
    let err_str: String = match r { Ok(_) => "", Err(e) => e };
    println(err_str);
    process_exit(1);
}
