// # Local-registry publish
//
// Logline: Write the local `ooda.pkg` manifest + payload to a registry directory tree. Sign with HMAC. Default registry is `.ooda-cache/registry`; `--to <dir>` overrides.
//
// Setup: Local tree only. No network. rest[0] is not skipped; --to is the first flag.
//
// Beats:
//   1. Read `ooda.pkg`. Refuse if missing or empty.
//   2. Resolve the registry root to an absolute path. Create each parent directory along the way.
//   3. Create `<root>/<name>/<version>/` and write `ooda.pkg`, the payload, and a signed `index`.
//   4. `--json` prints the path; otherwise text.

import "argv.oo";
import "slurp.oo";
import "resolve/ANCHOR.oo";
import "sign/ANCHOR.oo";
import "store/ANCHOR.oo";

pub fn run_ooda_pm_publish(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let to_dir: String = pm_publish_to(args);
    let json: Bool = pm_publish_json(args);
    let pkg_path: String = "ooda.pkg";
    let man: String = pm_slurp(fr, pkg_path);
    if man == "" {
        println("ERR\tpm publish\tmissing ooda.pkg");
        process_exit(1);
    }
    let name: String = pm_kv(man, "name");
    let ver: String = pm_kv(man, "version");
    if name == "" || ver == "" {
        println("ERR\tpm publish\tmanifest missing name= or version=");
        process_exit(1);
    }
    let payload_name: String = pm_kv(man, "payload");
    let payload_body: String = pm_slurp(fr, payload_name);
    if payload_body == "" {
        println("ERR\tpm publish\tmissing payload " + payload_name);
        process_exit(1);
    }
    let root: String = pm_root_abs(env);
    if root == "" {
        println("ERR\tpm publish\tOODA_FS_WRITEDIR required");
        process_exit(1);
    }
    let mut abs_root: String = root;
    if to_dir == "" || str_slice(to_dir, 0, 1) != "/" {
        abs_root = root + "/" + to_dir;
    } else {
        abs_root = to_dir;
    }
    let pkg_dir: String = abs_root + "/" + name + "/" + ver;
    if !pm_mkdir_p(fr, fw, abs_root) {
        println("ERR\tpm publish\tcannot create " + abs_root);
        process_exit(1);
    }
    if !pm_mkdir_p(fr, fw, pkg_dir) {
        println("ERR\tpm publish\tcannot create " + pkg_dir);
        process_exit(1);
    }
    if !pm_place(fw, pkg_dir + "/ooda.pkg", man) {
        println("ERR\tpm publish\twrite ooda.pkg failed");
        process_exit(1);
    }
    if !pm_place(fw, pkg_dir + "/" + payload_name, payload_body) {
        println("ERR\tpm publish\twrite payload failed");
        process_exit(1);
    }
    let sha: String = crypto_sha256_internal(man);
    let sig: String = pm_sign("ooda-local-pm", name, ver, sha);
    let index: String = "name=" + name + "\nversion=" + ver + "\nsha256=" + sha + "\nsig=" + sig + "\n";
    if !pm_place(fw, pkg_dir + "/index", index) {
        println("ERR\tpm publish\twrite index failed");
        process_exit(1);
    }
    if json {
        println("{\"ok\":true,\"path\":\"" + pkg_dir + "\",\"name\":\"" + name + "\",\"version\":\"" + ver + "\"}");
        return;
    }
    println("opm publish: wrote " + pkg_dir + " (name=" + name + ", version=" + ver + ")");
    let _p: &ProcessCap = proc;
}
