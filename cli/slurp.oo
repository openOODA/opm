// # File slurp, lock tokens, JSON escape
//
// Logline: Read files, split lock fields, and escape JSON. No HTTP.
//
// Setup: FsReadCap for slurp. FsWriteCap for place. Missing file is empty, not a throw.
//
// Beats:
//   1. slurp returns "" on miss. place writes or returns false.
//   2. Lock tokens are name@version#sha#commit#cap.
//   3. JSON string escape for --json lines.

pub fn pm_slurp(fr: &FsReadCap, path: String) -> String {
    if !path_exists(fr, path) {
        return "";
    }
    let rr: Result[String, String] = read_file(fr, path);
    match rr {
        Ok(s)  => { return s; }
        Err(m) => { return ""; }
    }
}

pub fn pm_is_http(s: String) -> Bool {
    if str_index_of(s, "://") >= 0 {
        return true;
    }
    if str_index_of(s, "catalog.openooda.org") >= 0 {
        return true;
    }
    return str_index_of(s, "registry.openooda.org") >= 0;
}

pub fn pm_jesc(s: String) -> String {
    let n: Int = chars_len(s);
    let mut out: String = "";
    let mut i: Int = 0;
    while i < n {
        let c: String = char_at(s, i);
        if c == "\\" { out = out + "\\\\"; }
        else if c == "\"" { out = out + "\\\""; }
        else if c == "\n" { out = out + "\\n"; }
        else { out = out + c; }
        i = i + 1;
    }
    return out;
}

pub fn pm_tok_name(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 1 {
        return tok;
    }
    return str_slice(tok, 0, at);
}

pub fn pm_tok_ver(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 1 {
        return "";
    }
    let rest: String = str_slice(tok, at + 1, chars_len(tok));
    let h: Int = str_index_of(rest, "#");
    if h < 0 {
        return rest;
    }
    return str_slice(rest, 0, h);
}

pub fn pm_tok_sha(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 0 {
        return "";
    }
    let rest: String = str_slice(tok, at + 1, chars_len(tok));
    let h: Int = str_index_of(rest, "#");
    if h < 0 {
        return "";
    }
    let after: String = str_slice(rest, h + 1, chars_len(rest));
    let h2: Int = str_index_of(after, "#");
    if h2 < 0 {
        return after;
    }
    return str_slice(after, 0, h2);
}

pub fn pm_tok_cap(tok: String) -> String {
    let at: Int = str_index_of(tok, "@");
    if at < 0 {
        return "";
    }
    let rest: String = str_slice(tok, at + 1, chars_len(tok));
    let h: Int = str_index_of(rest, "#");
    if h < 0 {
        return "";
    }
    let after: String = str_slice(rest, h + 1, chars_len(rest));
    let h2: Int = str_index_of(after, "#");
    if h2 < 0 {
        return "";
    }
    let after2: String = str_slice(after, h2 + 1, chars_len(after));
    let h3: Int = str_index_of(after2, "#");
    if h3 < 0 {
        return after2;
    }
    return str_slice(after2, h3 + 1, chars_len(after2));
}

pub fn pm_first_nonempty(a: String, b: String) -> String {
    if a != "" {
        return a;
    }
    return b;
}

pub fn pm_place(fw: &FsWriteCap, path: String, body: String) -> Bool {
    let wr: Result[Void, String] = write_file(fw, path, body);
    if wr.is_ok() {
        return true;
    }
    return false;
}

pub fn pm_lock_json(lock: String) -> String {
    let n: Int = chars_len(lock);
    let mut out: String = "[";
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut first: Bool = true;
    while i <= n {
        if i == n || char_at(lock, i) == "\n" {
            if i > start {
                let line: String = str_slice(lock, start, i);
                if str_index_of(line, "@") >= 1 {
                    if first == false {
                        out = out + ",";
                    }
                    first = false;
                    out = out + "{\"name\":\"" + pm_jesc(pm_tok_name(line)) + "\",\"version\":\"" + pm_jesc(pm_tok_ver(line)) + "\",\"sha\":\"" + pm_jesc(pm_tok_sha(line)) + "\",\"caps\":\"" + pm_jesc(pm_tok_cap(line)) + "\"}";
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out + "]";
}
