// # Pick a store or a local vendor for add
//
// Logline: Bare add searches listed HTTPS stores, then falls back to ../registry.
//
// Setup: --vendor is a folder. --from is a package dir. --registry still fetches one origin.
//
// Beats:
//   1. Honor --from and --vendor.
//   2. Find the first listed store that names the package.
//   3. Use ../registry when no store answers.

import "cmd_io.oo";
import "cmd_reg.oo";
import "registry/reg.oo";
import "registry/regs.oo";
import "opm/resolve/ANCHOR.oo";

fn pm_cat_has_name(cat: String, name: String) -> Bool {
    let n: Int = chars_len(cat);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(cat, i) == "\n" {
            if i > start {
                if pm_same(pm_line_field(str_slice(cat, start, i), 0), name) {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn pm_regs_pick(fr: &FsReadCap, proc: &ProcessCap, name: String, dest: String) -> String {
    if name == "" {
        return "err missing";
    }
    let urls: String = pm_regs_urls(fr, proc);
    let n: Int = chars_len(urls);
    let scan: String = dest + "-scan";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(urls, i) == "\n" {
            if i > start {
                let url: String = str_slice(urls, start, i);
                let base: String = pm_reg_base(url);
                if base != "" {
                    if pm_reg_pull(fr, proc, base + "/catalog", scan, "catalog") {
                        if pm_cat_has_name(pm_slurp(fr, scan + "/catalog"), name) {
                            return pm_reg_materialize(fr, proc, url, dest);
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "err missing";
}

pub fn pm_select_vendor(fr: &FsReadCap, proc: &ProcessCap, args: List[String]) -> String {
    let from: String = pm_opt(args, "--from");
    if from != "" {
        return from;
    }
    let v: String = pm_opt(args, "--vendor");
    if v != "" {
        if pm_is_http(v) {
            return "err file vendor required";
        }
        return v;
    }
    let dest: String = ".ooda-cache/ooda-tmp/regcache";
    if pm_flag(args, "--registry") {
        let mut ru: String = pm_opt(args, "--registry");
        if ru == "" {
            ru = pm_reg_default();
        }
        let fr: String = pm_reg_materialize(fr, proc, ru, dest);
        if fr == "ok" {
            return dest;
        }
        return fr;
    }
    let fr2: String = pm_regs_pick(fr, proc, pm_arg_name(args), dest);
    if fr2 == "ok" {
        return dest;
    }
    if path_exists(fr, "../registry") {
        return "../registry";
    }
    return fr2;
}
