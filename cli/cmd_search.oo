// # Search the openOODA catalog
//
// Logline: Print package names that match the query. Stock seed first, then vendor, then HTTPS.
//
// Setup: Empty query lists all. Local catalogs need no curl. HTTPS needs OODA_CURL.
//
// Beats:
//   1. Read seed/catalog and vendor/catalog on disk.
//   2. Then fetch each listed HTTPS store catalog.
//   3. Print name, version, caps, and store. No match is Err.

import "argv.oo";
import "slurp.oo";
import "search_match.oo";
import "reg_fetch.oo";
import "registry/reg.oo";
import "registry/regs.oo";
import "resolve/ANCHOR.oo";

fn pm_search_query(args: List[String]) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "pm" || a == "search" {
            i = i + 1;
        } else if str_slice(a, 0, 1) == "-" {
            i = i + 1;
        } else {
            return a;
        }
    }
    return "";
}

pub fn pm_search_catalog(cat: String, q: String, store: String) -> Int {
    let n: Int = chars_len(cat);
    let mut start: Int = 0;
    let mut i: Int = 0;
    let mut hits: Int = 0;
    while i <= n {
        if i == n || char_at(cat, i) == "\n" {
            if i > start {
                let line: String = str_slice(cat, start, i);
                let nm: String = pm_line_field(line, 0);
                if nm != "" {
                    if pm_search_hit(nm, q) {
                        println(nm + "  " + pm_line_field(line, 1) + "  " + pm_line_field(line, 2) + "  " + store);
                        hits = hits + 1;
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return hits;
}

pub fn run_ooda_pm_search(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let q: String = pm_search_query(args);
    let mut hits: Int = 0;
    hits = hits + pm_search_catalog(pm_slurp(fr, "seed/catalog"), q, "seed");
    hits = hits + pm_search_catalog(pm_slurp(fr, "vendor/catalog"), q, "vendor");
    let urls: String = pm_regs_urls(fr, env);
    let n: Int = chars_len(urls);
    let dest: String = ".ooda-cache/ooda-tmp/regsearch";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(urls, i) == "\n" {
            if i > start {
                let url: String = str_slice(urls, start, i);
                let base: String = pm_reg_base(url);
                if base != "" {
                    if pm_reg_pull(fr, fw, proc, env, base + "/catalog", dest, "catalog") {
                        hits = hits + pm_search_catalog(pm_slurp(fr, dest + "/catalog"), q, url);
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if hits == 0 {
        println("opm search: no match");
        process_exit(1);
    }
}
