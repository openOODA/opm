// # Opm CLI Command Interface — Anchor for Agents
//
// Logline: Front door for the opm command surface. Handlers vs helpers.
//
// Setup: main.oo dispatches live subcommands. Helpers are not commands.
//        find_compiler.oo and host_run.oo spawn oodac from OODA_COMPILER only.
//
// Beats:
//   1. Handlers: add, audit, sbom, bot, ingest, init, launch,
//      remove, update, outdated, why, pack, pkg, publish,
//      reg/registry/regs, search, tree, vendor, clean.
//   2. Helpers: argv, slurp, catalog, vendor_pick, git_clone, reg_fetch, tool.
//   3. pkg/ has lock and parse helpers used by cmd_pkg.
//   4. main.oo parses argv and dispatches. Unknown subcommand is ERR.

import "argv.oo";
import "slurp.oo";
import "catalog.oo";
import "tool.oo";
import "vendor_pick.oo";
import "git_clone.oo";
import "reg_fetch.oo";
import "add_select.oo";
import "add_lock.oo";
import "cmd_add.oo";
import "cmd_audit.oo";
import "cmd_bot.oo";
import "cmd_ingest.oo";
import "cmd_init.oo";
import "cmd_launch.oo";
import "cmd_ops.oo";
import "cmd_pack.oo";
import "cmd_pkg.oo";
import "cmd_publish.oo";
import "cmd_regs.oo";
import "cmd_search.oo";
import "cmd_tree.oo";
import "find_compiler.oo";
import "host_run.oo";
import "pkg/ANCHOR.oo";
import "main.oo";
