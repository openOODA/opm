// # Add select: vendor, name, resolve body
//
// Logline: Choose a file vendor and resolve catalog rows for add.
//
// Setup: --vendor/--from are paths. --registry fetches one origin. --pubgrub opts into backtracking.
//
// Beats:
//   1. sha/sig check of a package dir.
//   2. Resolve one name, a --from dir, or ooda.pkg deps.

import "catalog.oo";
import "slurp.oo";
import "sign/index.oo";
import "resolve/pubgrub.oo";
import "resolve/ANCHOR.oo";
import "lock/v2.oo";

pub fn pm_check_pkg(fr: &FsReadCap, dir: String, name: String, live: String) -> String {
    let man: String = pm_slurp(fr, dir + "/manifest");
    let want: String = pm_kv(man, "sha256");
    if want != "" {
        if want != live {
            return "sha256 mismatch " + name;
        }
    }
    let sig: String = pm_kv(man, "sig");
    if sig != "" {
        if !pm_sign_ok("ooda-local-pm", name, pm_kv(man, "version"), live, sig) {
            return "sig mismatch " + name;
        }
    }
    return "";
}

pub fn pm_add_body(fr: &FsReadCap, vendor: String, name: String, from: String, use_pubgrub: Bool) -> String {
    let cat: String = pm_load_work_catalog(fr, vendor);
    let pkg: String = pm_slurp(fr, "ooda.pkg");
    if name != "" {
        if use_pubgrub {
            return pm_pubgrub_resolve(cat, pm_replace_name(name, pm_kv(pkg, "replaces")), 1);
        }
        return pm_resolve(cat, pm_replace_name(name, pm_kv(pkg, "replaces")), 1);
    }
    if from != "" {
        let nm: String = pm_kv(pm_slurp(fr, from + "/manifest"), "name");
        if use_pubgrub {
            return pm_pubgrub_resolve(cat, pm_replace_name(nm, pm_kv(pkg, "replaces")), 1);
        }
        return pm_resolve(cat, pm_replace_name(nm, pm_kv(pkg, "replaces")), 1);
    }
    let roots: String = pm_dep_names(pm_kv(pkg, "deps"));
    if roots == "" {
        return "err missing";
    }
    if use_pubgrub {
        return pm_pubgrub_resolve_names(cat, roots, 1);
    }
    return pm_resolve_names(cat, roots, 1);
}
