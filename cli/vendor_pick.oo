// # Pick a store or a local vendor for add
//
// Logline: --vendor and --from are file paths. --registry fetches one origin. No sibling fallback.
//
// Setup: Missing store is Err. HTTPS fetch needs OODA_CURL.
//
// Beats:
//   1. Honor --from and --vendor.
//   2. Find the first listed store that names the package.
//   3. No ../registry. No silent path.

import "argv.oo";
import "slurp.oo";
import "reg_fetch.oo";
import "registry/reg.oo";
import "registry/regs.oo";
import "resolve/ANCHOR.oo";

fn pm_cat_has_name(cat: String, name: String) -> Bool {
    let n: Int = chars_len(cat);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(cat, i) == "\n" {
            if i > start {
                if pm_same(pm_line_field(str_slice(cat, start, i), 0), name) {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn pm_regs_pick(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, name: String, dest: String) -> String {
    if name == "" {
        return "err missing";
    }
    let urls: String = pm_regs_urls(fr, env);
    let n: Int = chars_len(urls);
    let scan: String = dest + "-scan";
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(urls, i) == "\n" {
            if i > start {
                let url: String = str_slice(urls, start, i);
                let base: String = pm_reg_base(url);
                if base != "" {
                    if pm_reg_pull(fr, fw, proc, env, base + "/catalog", scan, "catalog") {
                        if pm_cat_has_name(pm_slurp(fr, scan + "/catalog"), name) {
                            return pm_reg_materialize(fr, fw, proc, env, url, dest);
                        }
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "err missing";
}

pub fn pm_select_vendor(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) -> String {
    let from: String = pm_opt(args, "--from");
    if from != "" {
        return from;
    }
    let v: String = pm_opt(args, "--vendor");
    if v != "" {
        if pm_is_http(v) {
            return "err file vendor required";
        }
        return v;
    }
    if path_exists(fr, "vendor") {
        return "vendor";
    }
    let dest: String = ".ooda-cache/ooda-tmp/regcache";
    if pm_flag(args, "--registry") {
        let mut ru: String = pm_opt(args, "--registry");
        if ru == "" {
            ru = pm_reg_default();
        }
        let frs: String = pm_reg_materialize(fr, fw, proc, env, ru, dest);
        if frs == "ok" {
            return dest;
        }
        return frs;
    }
    return pm_regs_pick(fr, fw, proc, env, pm_arg_name(args), dest);
}
