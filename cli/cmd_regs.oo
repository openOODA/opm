// # Add and remove extra HTTPS stores
//
// Logline: List stores, add a signed extra origin, or drop one.
//
// Setup: Stock is always listed. Extra add fetches catalog, minisig, and registry.pub. Needs OODA_CURL and OODA_MINISIGN.
//
// Beats:
//   1. registry with no verb lists stock plus extras.
//   2. add URL verifies minisign and pins the pubkey.
//   3. remove URL refuses the stock store.

import "argv.oo";
import "slurp.oo";
import "reg_fetch.oo";
import "registry/reg.oo";
import "registry/regs.oo";
import "store/store.oo";

fn pm_regs_verb(args: List[String]) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "add" || a == "remove" || a == "list" {
            return a;
        }
        i = i + 1;
    }
    return "list";
}

fn pm_regs_url_arg(args: List[String]) -> String {
    let mut i: Int = 0;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if a == "pm" || a == "registry" || a == "regs" || a == "reg" || a == "add" || a == "remove" || a == "list" {
            i = i + 1;
        } else if str_slice(a, 0, 1) == "-" {
            i = i + 1;
        } else {
            return a;
        }
    }
    return "";
}

fn pm_regs_pin_pub(fr: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, url: String, body: String) -> Bool {
    let path: String = pm_regs_key_path(fr, env, url);
    if path == "" {
        return false;
    }
    let home: String = pm_regs_home(env);
    if !pm_mkdir_p(fr, fw, home + "/keys") {
        return false;
    }
    return write_file(fw, path, body).is_ok();
}

fn pm_regs_trust(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, url: String) -> String {
    if pm_reg_origin_ok(url) {
        return "ok stock";
    }
    if !pm_reg_https_ok(url) {
        return "err allow";
    }
    let dest: String = ".ooda-cache/ooda-tmp/regadd";
    let base: String = pm_reg_base(url);
    if !pm_reg_pull(fr, fw, proc, env, base + "/catalog", dest, "catalog") {
        return "err fetch";
    }
    if !pm_reg_pull(fr, fw, proc, env, base + "/index.minisig", dest, "index.minisig") {
        return "err fetch";
    }
    if !pm_reg_pull(fr, fw, proc, env, base + "/registry.pub", dest, "registry.pub") {
        return "err minisign";
    }
    let vr: String = pm_reg_minisign_ok(fr, proc, env, dest + "/registry.pub", dest + "/catalog", dest + "/index.minisig");
    if vr != "ok" {
        return vr;
    }
    if !pm_regs_pin_pub(fr, fw, env, url, pm_slurp(fr, dest + "/registry.pub")) {
        return "err write";
    }
    return pm_regs_put(fr, fw, env, url);
}

pub fn run_ooda_pm_regs(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let op: String = pm_regs_verb(args);
    if op == "list" {
        let urls: String = pm_regs_urls(fr, env);
        let n: Int = chars_len(urls);
        let mut start: Int = 0;
        let mut i: Int = 0;
        while i <= n {
            if i == n || char_at(urls, i) == "\n" {
                if i > start {
                    let one: String = str_slice(urls, start, i);
                    if pm_reg_origin_ok(one) {
                        println(one + "  (stock)");
                    } else {
                        println(one);
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return;
    }
    let url: String = pm_regs_url_arg(args);
    if url == "" {
        println("ERR\tregistry\tmissing url");
        println("usage: opm registry add|remove https://host");
        process_exit(2);
    }
    if op == "add" {
        let r: String = pm_regs_trust(fr, fw, proc, env, url);
        if str_slice(r, 0, 2) != "ok" {
            println("ERR\tregistry\t" + str_slice(r, 4, chars_len(r)));
            process_exit(2);
        }
        println("opm registry: added " + url);
        return;
    }
    if op == "remove" {
        let r2: String = pm_regs_drop(fr, fw, env, url);
        if r2 != "ok" {
            println("ERR\tregistry\t" + str_slice(r2, 4, chars_len(r2)));
            process_exit(2);
        }
        println("opm registry: removed " + url);
        return;
    }
    println("ERR\tregistry\tunknown command");
    process_exit(2);
}
