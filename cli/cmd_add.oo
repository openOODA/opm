// # Product add from a file-backed vendor
//
// Logline: Resolve named or manifest deps, write CAS/lock/vendor, and print text or --json.
//
// Setup: --vendor is a folder. --from DIR is offline. --pubgrub opts into pm_pubgrub_resolve.
//
// Beats:
//   1. Refuse bad hosts, yank, license, pin, traversal, extra caps, and sha/sig miss.
//   2. Install each resolved node into CAS, copy vendor/<payload>, write a v2 lock.
//   3. Structured ERR on failure. --json prints a machine object.

import "add_select.oo";
import "add_lock.oo";
import "argv.oo";
import "slurp.oo";
import "vendor_pick.oo";
import "core/name.oo";
import "lock/v2.oo";
import "sign/index.oo";

pub fn run_ooda_pm_add(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let mut vendor: String = pm_select_vendor(fr, fw, proc, env, args);
    if chars_len(vendor) >= 4 {
        if str_slice(vendor, 0, 4) == "err " {
            println("ERR\tpm\t" + str_slice(vendor, 4, chars_len(vendor)));
            println("opm add: " + str_slice(vendor, 4, chars_len(vendor)));
            process_exit(2);
        }
    }
    let mut name: String = pm_arg_name(args);
    let from: String = pm_opt(args, "--from");
    if from != "" {
        vendor = from;
        if path_exists(fr, from + "/manifest") {
            name = pm_kv(pm_slurp(fr, from + "/manifest"), "name");
        }
    }
    let pkg: String = pm_slurp(fr, "ooda.pkg");
    if name == "" {
        let roots: String = pm_dep_names(pm_kv(pkg, "deps"));
        if roots == "" {
            println("ERR\tpm\tmissing package name");
            println("usage: opm add <name> [--vendor path]");
            process_exit(2);
        }
    } else {
        name = pm_replace_name(name, pm_kv(pkg, "replaces"));
        if !pm_name_ok(name) {
            println("ERR\tpm\trefuse name");
            println("opm add: refuse name");
            process_exit(2);
        }
    }
    if !path_exists(fr, vendor) {
        println("ERR\tpm\tmissing vendor");
        println("opm add: missing vendor");
        process_exit(2);
    }
    if path_exists(fr, vendor + "/index") {
        if !pm_index_ok(pm_slurp(fr, vendor + "/index"), pm_slurp(fr, vendor + "/index.sig")) {
            println("ERR\tpm\tindex");
            println("opm add: index");
            process_exit(2);
        }
    }
    let res: String = pm_add_body(fr, vendor, name, from, pm_flag(args, "--pubgrub"));
    if chars_len(res) < 3 {
        println("ERR\tpm\t" + res);
        println("opm add: " + res);
        process_exit(2);
    }
    if str_slice(res, 0, 3) != "ok " {
        println("ERR\tpm\t" + res);
        println("opm add: " + res);
        process_exit(2);
    }
    let body: String = str_slice(res, 3, chars_len(res));
    pm_add_write(fr, fw, env, args, vendor, name, body);
}
