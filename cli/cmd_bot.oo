// # Package registry bot
//
// Logline: Walk a registry folder, verify each package, write catalog. Fail closed.
//
// Setup: Target dir from rest[0]. Writes catalog with write_file. Sign needs OODA_MINISIGN.
//
// Beats:
//   1. Parse target folder and --sign from rest starting at 0.
//   2. Walk the folder. Verify each named package. First failed verify is Err.
//   3. Write catalog and index. --sign requires OODA_MINISIGN and OODA_MINISIGN_SK.

import "argv.oo";
import "slurp.oo";
import "tool.oo";
import "catalog.oo";
import "core/ANCHOR.oo";
import "resolve/ANCHOR.oo";

pub fn pm_bot_verify_pkg(fr: &FsReadCap, base_dir: String, pkg_name: String) -> String {
    let pkg_path: String = base_dir + "/" + pkg_name;
    let man_path: String = pkg_path + "/manifest";
    if !path_exists(fr, man_path) {
        return "missing manifest";
    }
    let man_text: String = pm_slurp(fr, man_path);
    let ver: String = pm_kv(man_text, "version");
    if ver == "" {
        return "missing version in manifest";
    }
    let payload: String = pm_kv(man_text, "payload");
    let mut pay_file: String = payload;
    if pay_file == "" {
        pay_file = pkg_name + ".oo";
    }
    let src_path: String = pkg_path + "/" + pay_file;
    if !path_exists(fr, src_path) {
        return "missing payload file " + pay_file;
    }
    let src_text: String = pm_slurp(fr, src_path);
    let live_sha: String = crypto_sha256_internal(src_text);
    let want_sha: String = pm_kv(man_text, "sha256");
    if want_sha != "" && want_sha != live_sha {
        return "sha256 mismatch (want " + want_sha + " got " + live_sha + ")";
    }
    if str_index_of(src_text, "// # ") < 0 || str_index_of(src_text, "// Logline:") < 0 {
        return "missing Academy headers in " + pay_file;
    }
    let caps: String = pm_kv(man_text, "caps");
    let deps: String = pm_kv(man_text, "deps");
    return "ok|" + pkg_name + "|" + ver + "|" + caps + "|" + deps + "|" + live_sha;
}

pub fn run_ooda_pm_bot(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    let target_dir: String = pm_bot_target(args);
    let do_sign: Bool = pm_bot_sign(args);
    if !path_exists(fr, target_dir) {
        println("ERR\tpm\ttarget registry directory not found: " + target_dir);
        process_exit(2);
    }
    let names: String = pm_list_dir(fr, target_dir);
    let nms: Int = chars_len(names);
    let mut catalog_acc: String = "";
    let mut verified_count: Int = 0;
    let mut start: Int = 0;
    let mut pi: Int = 0;
    while pi <= nms {
        if pi == nms || char_at(names, pi) == "\n" {
            if pi > start {
                let p_name: String = str_slice(names, start, pi);
                if pm_name_ok(p_name) {
                    if path_exists(fr, target_dir + "/" + p_name + "/manifest") {
                        let res: String = pm_bot_verify_pkg(fr, target_dir, p_name);
                        if chars_len(res) >= 3 && str_slice(res, 0, 3) == "ok|" {
                            let entry: String = str_slice(res, 3, chars_len(res));
                            catalog_acc = catalog_acc + entry + "\n";
                            verified_count = verified_count + 1;
                        } else {
                            println("ERR\tpm\tpackage " + p_name + " failed check: " + res);
                            process_exit(2);
                        }
                    }
                }
            }
            start = pi + 1;
        }
        pi = pi + 1;
    }
    let cat_path: String = target_dir + "/catalog";
    let idx_path: String = target_dir + "/index";
    if !pm_place(fw, cat_path, catalog_acc) {
        println("ERR\tpm\tfailed to write catalog");
        process_exit(1);
    }
    if !pm_place(fw, idx_path, catalog_acc) {
        println("ERR\tpm\tfailed to write index");
        process_exit(1);
    }
    if do_sign {
        let ms_r: Result[String, String] = pm_tool_path(fr, env, "OODA_MINISIGN");
        let sk_r: Result[String, String] = pm_tool_path(fr, env, "OODA_MINISIGN_SK");
        if ms_r.is_err() || sk_r.is_err() {
            println("ERR\tpm\tOODA_MINISIGN and OODA_MINISIGN_SK required for --sign");
            process_exit(2);
        }
        let ms: String = match ms_r { Ok(s) => s, Err(_) => "" };
        let sk: String = match sk_r { Ok(s) => s, Err(_) => "" };
        let sr: Result[String, String] = sys_exec(proc, ms, "-Sm", idx_path, "-s", sk);
        if sr.is_err() {
            println("ERR\tpm\tminisign sign failed");
            process_exit(1);
        }
    }
    println("opm bot: verified " + verified_count.to_string() + " packages, updated " + cat_path);
}

pub fn cmd_pm_bot_run(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, args: List[String]) {
    run_ooda_pm_bot(fr, fw, proc, env, args);
}

pub fn cmd_pm_bot_verify(fr: &FsReadCap, base_dir: String, pkg_name: String) -> String {
    return pm_bot_verify_pkg(fr, base_dir, pkg_name);
}
