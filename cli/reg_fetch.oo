// # Fetch a static HTTPS vendor into a local cache
//
// Logline: GET catalog and index.minisig. Verify minisign. Then add is file-backed.
//
// Setup: curl from OODA_CURL. minisign from OODA_MINISIGN. No PATH. No shell.
//
// Beats:
//   1. Refuse a host that is not stock and not listed.
//   2. minisign -V must pass. Missing binary is Err.
//   3. Fetch each catalog name's manifest and payload.

import "slurp.oo";
import "tool.oo";
import "core/name.oo";
import "registry/reg.oo";
import "registry/regs.oo";
import "resolve/ANCHOR.oo";
import "store/store.oo";

pub fn pm_reg_pub_path() -> String {
    return "cli/registry.pub";
}

pub fn pm_reg_minisign_ok(fr: &FsReadCap, proc: &ProcessCap, env: &EnvCap, pubp: String, msgp: String, sigp: String) -> String {
    if !path_exists(fr, pubp) {
        return "err minisign";
    }
    if !path_exists(fr, msgp) {
        return "err index";
    }
    if !path_exists(fr, sigp) {
        return "err index";
    }
    let ms_r: Result[String, String] = pm_tool_path(fr, env, "OODA_MINISIGN");
    if ms_r.is_err() {
        return "err minisign";
    }
    let ms: String = match ms_r { Ok(s) => s, Err(_) => "" };
    let r: Result[String, String] = sys_exec(proc, ms, "-V", "-p", pubp, "-m", msgp, "-x", sigp);
    if r.is_ok() {
        return "ok";
    }
    return "err index";
}

pub fn pm_reg_pull(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, url: String, dir: String, leaf: String) -> Bool {
    if !pm_reg_rel_ok(leaf) {
        return false;
    }
    let curl_r: Result[String, String] = pm_tool_path(fr, env, "OODA_CURL");
    if curl_r.is_err() {
        return false;
    }
    let curl: String = match curl_r { Ok(s) => s, Err(_) => "" };
    if !pm_mkdir_p(fr, fw, dir) {
        return false;
    }
    let dest: String = dir + "/" + leaf;
    let r: Result[String, String] = sys_exec(proc, curl, "-fsS", "-o", dest, url);
    if r.is_err() {
        return false;
    }
    if !path_exists(fr, dest) {
        return false;
    }
    if pm_slurp(fr, dest) == "" {
        return false;
    }
    return true;
}

fn pm_reg_fetch_pkg(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, base: String, dest: String, name: String) -> Bool {
    if !pm_name_ok(name) {
        return false;
    }
    let dir: String = dest + "/" + name;
    if !pm_reg_pull(fr, fw, proc, env, base + "/" + name + "/manifest", dir, "manifest") {
        return false;
    }
    let man: String = pm_slurp(fr, dir + "/manifest");
    let mut pay: String = pm_kv(man, "payload");
    if pay == "" {
        pay = name + ".oo";
    }
    if !pm_reg_rel_ok(pay) {
        return false;
    }
    if !pm_reg_pull(fr, fw, proc, env, base + "/" + name + "/" + pay, dir, pay) {
        return false;
    }
    let outl: String = pm_kv(man, "outline");
    if outl == "" {
        return true;
    }
    if !pm_reg_rel_ok(outl) {
        return true;
    }
    let _o: Bool = pm_reg_pull(fr, fw, proc, env, base + "/" + name + "/" + outl, dir, outl);
    return true;
}

fn pm_reg_key(fr: &FsReadCap, env: &EnvCap, url: String) -> String {
    if pm_reg_origin_ok(url) {
        return pm_reg_pub_path();
    }
    return pm_regs_key_path(fr, env, url);
}

pub fn pm_reg_allowed(fr: &FsReadCap, env: &EnvCap, url: String) -> Bool {
    if pm_reg_origin_ok(url) {
        return true;
    }
    if !pm_reg_https_ok(url) {
        return false;
    }
    return pm_regs_has(fr, env, url);
}

pub fn pm_reg_materialize(fr: &FsReadCap, fw: &FsWriteCap, proc: &ProcessCap, env: &EnvCap, url: String, dest: String) -> String {
    if !pm_reg_allowed(fr, env, url) {
        return "err allow";
    }
    let base: String = pm_reg_base(url);
    if !pm_reg_pull(fr, fw, proc, env, base + "/catalog", dest, "catalog") {
        return "err fetch";
    }
    if !pm_reg_pull(fr, fw, proc, env, base + "/index.minisig", dest, "index.minisig") {
        return "err fetch";
    }
    let vr: String = pm_reg_minisign_ok(fr, proc, env, pm_reg_key(fr, env, url), dest + "/catalog", dest + "/index.minisig");
    if vr != "ok" {
        return vr;
    }
    let idx: String = pm_slurp(fr, dest + "/catalog");
    let _y: Bool = pm_reg_pull(fr, fw, proc, env, base + "/yank", dest, "yank");
    let n: Int = chars_len(idx);
    let mut start: Int = 0;
    let mut i: Int = 0;
    while i <= n {
        if i == n || char_at(idx, i) == "\n" {
            if i > start {
                let line: String = str_slice(idx, start, i);
                let nm: String = pm_line_field(line, 0);
                if nm != "" {
                    if !pm_reg_fetch_pkg(fr, fw, proc, env, base, dest, nm) {
                        return "err fetch";
                    }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return "ok";
}
