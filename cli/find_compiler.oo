// # Find oodac from one explicit token
//
// Logline: Resolve the compiler path from OODA_COMPILER only. No path chain. No HOME. No PATH.
//
// Setup: &FsReadCap validates the path. &EnvCap reads OODA_COMPILER.
//
// Beats:
//   1. Require OODA_COMPILER. Fail closed when unset or empty.
//   2. Reject a path whose basename is the product CLI (`ooda`).
//   3. Reject a path that does not exist under FsReadCap.

import "tool.oo";

fn is_product_cli(path: String) -> Bool {
    let n: Int = chars_len(path);
    if n == 4 {
        return path == "ooda";
    }
    if n < 5 {
        return false;
    }
    if str_slice(path, n - 5, n) == "/ooda" {
        return true;
    }
    return false;
}

pub fn resolve_oodac(fs: &FsReadCap, env: &EnvCap) -> Result[String, String] {
    let r: Result[String, String] = pm_tool_path(fs, env, "OODA_COMPILER");
    if r.is_err() {
        return r;
    }
    let p: String = match r { Ok(s) => s, Err(_) => "" };
    if is_product_cli(p) {
        return Err("OODA_COMPILER is the product CLI");
    }
    return Ok(p);
}

pub fn find_oodac(fs: &FsReadCap, env: &EnvCap) -> String {
    let r: Result[String, String] = resolve_oodac(fs, env);
    if r.is_err() {
        let msg: String = match r { Ok(_) => "", Err(e) => e };
        println("ERR\tcli\t" + msg);
        process_exit(1);
    }
    return match r { Ok(s) => s, Err(_) => "" };
}
