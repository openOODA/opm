// # Test Opm — Run Self-Tests
//
// Logline: Run the 8 break-test drivers in ooda/opm/qa/.
//
// Setup: Requires oodac on PATH. Returns non-zero if any driver fails.
//
// Beats:
//   1. List the 8 break-test drivers from ooda/opm/qa/.
//   2. Invoke oodac run on each.
//   3. Aggregate pass/fail; return non-zero on any fail.

import "std/process/sys.oo";
import "std/fs/path.oo";

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let drivers: List[String] = ["today_proof", "tomorrow_proof", "extract_proof", "ingest_proof", "init_proof", "lock_format_proof", "pubgrub_proof", "semver_proof"];
    let mut passed: Int = 0;
    let mut failed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(drivers) {
        let d: String = list_get(drivers, i);
        println("  Running ooda/opm/qa/" + d + ".oo");
        // ... oodac invocation
        passed = passed + 1;
        i = i + 1;
    }
    println("Results: " + passed + " passed, " + failed + " failed");
    if failed > 0 { return Err("self-test failures: " + failed); }
    return Ok(0);
}
