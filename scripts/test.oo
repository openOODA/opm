// # Test Opm — Run Self-Tests
//
// Logline: Typecheck each qa/ driver through oodac check. Fail closed. Double-run.
//
// Setup: Run from the opm repo root. Requires ProcessCap, FsReadCap, EnvCap.
//        OODA_COMPILER must point at oodac. No PATH hunt.
//        oodac run still looks for ./bin/oodac_bin.core; check is the live gate.
//
// Beats:
//   1. Resolve oodac from OODA_COMPILER only.
//   2. oodac check each driver twice. Fail on the first Err or ERR in stdout.
//   3. Registry proofs in registry/ also check.

fn find_oodac(fs: &FsReadCap, env: &EnvCap) -> String {
    let r: Result[String, String] = env_get(env, "OODA_COMPILER");
    let p: String = match r { Ok(s) => s, Err(_) => "" };
    if p == "" {
        println("ERR\ttest\tOODA_COMPILER required");
        process_exit(1);
    }
    if !path_exists(fs, p) {
        println("ERR\ttest\tOODA_COMPILER missing: " + p);
        process_exit(1);
    }
    return p;
}

fn run_one(p: &ProcessCap, oodac: String, path: String) -> Bool {
    println("  Checking " + path);
    let r1: Result[String, String] = sys_exec(p, oodac, "check", path);
    if r1.is_err() {
        let err: String = match r1 { Ok(_) => "", Err(e) => e };
        println(err);
        return false;
    }
    let out1: String = match r1 { Ok(s) => s, Err(_) => "" };
    println(out1);
    if str_index_of(out1, "ERR") >= 0 {
        println("ERR\ttest\tERR in stdout " + path);
        return false;
    }
    let r2: Result[String, String] = sys_exec(p, oodac, "check", path);
    if r2.is_err() {
        let err2: String = match r2 { Ok(_) => "", Err(e) => e };
        println(err2);
        return false;
    }
    return true;
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let oodac: String = find_oodac(fs_r, env);
    let mut drivers: List[String] = list_new();
    drivers = list_push(drivers, "qa/today_proof.oo");
    drivers = list_push(drivers, "qa/tomorrow_proof.oo");
    drivers = list_push(drivers, "qa/extract_proof.oo");
    drivers = list_push(drivers, "qa/ingest_proof.oo");
    drivers = list_push(drivers, "qa/init_proof.oo");
    drivers = list_push(drivers, "qa/lock_format_proof.oo");
    drivers = list_push(drivers, "qa/pubgrub_proof.oo");
    drivers = list_push(drivers, "qa/semver_proof.oo");
    drivers = list_push(drivers, "qa/argv_init_proof.oo");
    drivers = list_push(drivers, "qa/argv_bot_proof.oo");
    drivers = list_push(drivers, "qa/argv_publish_proof.oo");
    drivers = list_push(drivers, "qa/help_surface_proof.oo");
    drivers = list_push(drivers, "qa/sbom_dispatch_proof.oo");
    drivers = list_push(drivers, "qa/compiler_token_proof.oo");
    drivers = list_push(drivers, "qa/no_shell_proof.oo");
    drivers = list_push(drivers, "qa/search_proof.oo");
    drivers = list_push(drivers, "registry/git_ingest_proof.oo");
    drivers = list_push(drivers, "registry/reg_proof.oo");
    let mut failed: Int = 0;
    let mut i: Int = 0;
    while i < list_len(drivers) {
        let path: String = list_get(drivers, i);
        if !run_one(p, oodac, path) {
            failed = failed + 1;
            return Err("self-test failures");
        }
        i = i + 1;
    }
    if failed > 0 {
        println("self-test failures");
        return Err("self-test failures");
    }
    println("self-test passed");
    let _a: Int = list_len(args);
    return Ok(0);
}
