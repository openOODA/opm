// # Bot argv rest proof
//
// Logline: bot reads the target dir from rest[0], not index 1.
//
// Setup: Pure list checks. No file write.
//
// Beats:
//   1. First positional is the target dir.
//   2. --sign does not skip the dir.
//   3. Empty rest defaults to registry.

import "cli/argv.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn one(a: String) -> List[String] {
    let mut xs: List[String] = list_new();
    return list_push(xs, a);
}

fn two(a: String, b: String) -> List[String] {
    let mut xs: List[String] = list_new();
    xs = list_push(xs, a);
    return list_push(xs, b);
}

pub fn main() {
    if pm_bot_target(one("mydir")) != "mydir" { fail("mydir"); }
    if pm_bot_target(two("--sign", "mydir")) != "mydir" { fail("sign then dir"); }
    if pm_bot_target(two("mydir", "--sign")) != "mydir" { fail("dir then sign"); }
    let empty: List[String] = list_new();
    if pm_bot_target(empty) != "registry" { fail("default"); }
    if pm_bot_sign(one("--sign")) == false { fail("sign flag"); }
    if pm_bot_sign(empty) == true { fail("no sign"); }
    println("argv_bot_proof: PASSED");
}
