// # Publish argv rest proof
//
// Logline: publish reads --to from rest starting at 0.
//
// Setup: Pure list checks. No file write.
//
// Beats:
//   1. --to /tmp/r is the dest.
//   2. --json is seen.
//   3. Empty rest uses the default cache path.

import "cli/argv.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    if pm_publish_to(["--to", "/tmp/r"]) != "/tmp/r" { fail("to"); }
    if pm_publish_json(["--json"]) == false { fail("json"); }
    if pm_publish_to([]) != ".ooda-cache/registry" { fail("default"); }
    println("argv_publish_proof: PASSED");
}
