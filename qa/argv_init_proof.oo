// # Init argv rest proof
//
// Logline: opm init reads the project name from rest[0], not index 2.
//
// Setup: Calls pm_argv_self_test in argv.oo.
//
// Beats:
//   1. rest[0] is the name.
//   2. Flags do not steal the name.
//   3. Empty rest defaults to pkg.

import "cli/argv.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    if !pm_argv_self_test() { fail("argv self test"); }
    println("argv_init_proof: PASSED");
}
