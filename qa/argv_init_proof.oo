// # Init argv rest proof
//
// Logline: opm init reads the project name from rest[0], not index 2.
//
// Setup: Pure list checks. No file write.
//
// Beats:
//   1. ["myapp"] is name myapp.
//   2. Flags do not steal the name.
//   3. Empty rest defaults to pkg.

import "cli/argv.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

pub fn main() {
    if pm_init_name(["myapp"]) != "myapp" { fail("myapp"); }
    if pm_init_name(["--json", "myapp"]) != "myapp" { fail("flag then name"); }
    if pm_init_name(["myapp", "--json"]) != "myapp" { fail("name then flag"); }
    if pm_init_name([]) != "pkg" { fail("empty default"); }
    if pm_init_name(["--json"]) != "pkg" { fail("json only"); }
    println("argv_init_proof: PASSED");
}
