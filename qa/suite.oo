// # Test OPM Package Manager — Run Proofs Twice
//
// Logline: Run each opm proof probe twice in fresh processes under the primary compiler. Fail closed on miss.
//
// Setup: Double-run identity law for OPM proofs. Compiler resolves with zero user config.
//
// Beats:
//   1. Resolve primary compiler binary (OODA_COMPILER, OODA_TOOLCHAIN, HOME).
//   2. Enumerate qa/*_proof.oo, qa/probe_*.oo, registry/*_proof.oo (floor 22).
//   3. Compile and execute each proof twice in fresh processes.
//   4. Report every failure; clean up binaries; exit 0 only if none failed.

import "std/fs/process/env.oo";
import "std/fs/file/glob.oo";
import "std/core/text/natural_sort.oo";

fn run_probe_once(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let tmp_bin: String = path + ".tmp.bin";
    let b: Result[String, String] = sys_exec(p, oodac, "build", path, "-o", tmp_bin);
    if b.is_err() {
        let e: String = match b { Ok(_) => "", Err(m) => m };
        return Err("compile fail " + path + ": " + e);
    }
    let r: Result[String, String] = sys_exec(p, tmp_bin);
    let _del: Result[String, String] = sys_exec(p, "rm", "-f", tmp_bin);
    if r.is_err() {
        let e: String = match r { Ok(_) => "", Err(m) => m };
        return Err("exec fail " + path + ": " + e);
    }
    return Ok(0);
}

fn run_probe_twice(p: &ProcessCap, oodac: String, path: String) -> Result[Int, String] {
    let r1: Result[Int, String] = run_probe_once(p, oodac, path);
    if r1.is_err() { return r1; }
    let r2: Result[Int, String] = run_probe_once(p, oodac, path);
    if r2.is_err() { return r2; }
    return Ok(0);
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, env: &EnvCap, args: List[String]) -> Result[Int, String] {
    let cr: Result[String, String] = env_get(env, "OODA_COMPILER");
    let mut oodac: String = match cr { Ok(s) => s, Err(_) => "" };
    if oodac == "" {
        let tr: Result[String, String] = env_get(env, "OODA_TOOLCHAIN");
        let th: String = match tr { Ok(s) => s, Err(_) => "" };
        if th != "" { oodac = th + "/bin/oodac"; }
    }
    if oodac == "" {
        let hr: Result[String, String] = env_get(env, "HOME");
        let home: String = match hr { Ok(s) => s, Err(_) => "" };
        if home != "" { oodac = home + "/.openooda/bin/oodac"; }
    }
    if oodac == "" || !path_exists(fs_r, oodac) {
        return Err("no compiler (OODA_COMPILER, OODA_TOOLCHAIN, or HOME layout)");
    }

    let g1: List[String] = glob_scan_dir(fs_r, "qa/cli", "*_proof.oo");
    let g1_p: List[String] = glob_scan_dir(fs_r, "qa/cli", "probe_*.oo");
    let g2: List[String] = glob_scan_dir(fs_r, "qa/pack", "*_proof.oo");
    let g3: List[String] = glob_scan_dir(fs_r, "qa/dep", "*_proof.oo");
    let g_reg: List[String] = glob_scan_dir(fs_r, "registry", "*_proof.oo");
    let mut ps: List[String] = list_new();
    let mut gi: Int = 0;
    while gi < list_len(g1) {
        ps = list_push(ps, list_get(g1, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(g1_p) {
        ps = list_push(ps, list_get(g1_p, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(g2) {
        ps = list_push(ps, list_get(g2, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(g3) {
        ps = list_push(ps, list_get(g3, gi));
        gi = gi + 1;
    }
    gi = 0;
    while gi < list_len(g_reg) {
        ps = list_push(ps, list_get(g_reg, gi));
        gi = gi + 1;
    }
    ps = natural_sort_list(ps);
    if list_len(ps) < 22 {
        return Err("proof floor violated: found " + list_len(ps).to_string() + ", need >= 22");
    }
    println("opm suite: enumerated " + list_len(ps).to_string() + " proofs");

    let mut failed: Int = 0;
    let mut first_err: String = "";
    let mut i: Int = 0;
    while i < list_len(ps) {
        let path: String = list_get(ps, i);
        println("  Running " + path);
        let r: Result[Int, String] = run_probe_twice(p, oodac, path);
        if r.is_err() {
            let m: String = match r { Ok(_) => "", Err(e) => e };
            println("opm suite FAIL: " + m);
            if failed == 0 { first_err = m; }
            failed = failed + 1;
        } else {
            println("  Passed " + path);
        }
        i = i + 1;
    }
    if failed != 0 {
        println("opm test suite: " + failed.to_string() + " proof(s) failed");
        return Err(first_err);
    }
    println("opm test suite: ALL PROOFS PASSED (double-run identical)");
    return Ok(0);
}
