// # No shell proof
//
// Logline: cli/ and registry/ must not sys_exec sh -c or PATH-hunt via command -v.
//
// Setup: Reads listed source files under FsReadCap.
//
// Beats:
//   1. No sys_exec(<any-cap>, "sh") — first arg name is not allowlisted.
//   2. No "sh", "-c".
//   3. No command -v.
// NOTE: curated file list; CI adds a repo-wide grep backstop so new
// files cannot escape (see .github/workflows/ci.yml).

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

// True when any sys_exec( call spawns "sh" (any capability var name).
fn has_spawn_sh(t: String) -> Bool {
    let n: Int = chars_len(t);
    let mut off: Int = 0;
    while off < n {
        let rest: String = str_slice(t, off, n);
        let k: Int = str_index_of(rest, "sys_exec(");
        if k < 0 { return false; }
        let m: Int = chars_len(rest);
        let mut end: Int = k + 48;
        if end > m { end = m; }
        let seg: String = str_slice(rest, k, end);
        if str_index_of(seg, "\"sh\"") >= 0 { return true; }
        off = off + k + 9;
    }
    return false;
}

fn scan(fs: &FsReadCap, path: String) {
    if !path_exists(fs, path) {
        return;
    }
    let rr: Result[String, String] = read_file(fs, path);
    let t: String = match rr { Ok(s) => s, Err(_) => "" };
    if has_spawn_sh(t) {
        fail("sh exec in " + path);
    }
    if str_index_of(t, "\"sh\", \"-c\"") >= 0 {
        fail("sh -c in " + path);
    }
    if str_index_of(t, "command -v") >= 0 {
        fail("command -v in " + path);
    }
}

pub fn main(fs: &FsReadCap) {
    scan(fs, "cli/host_run.oo");
    scan(fs, "cli/git_clone.oo");
    scan(fs, "cli/reg_fetch.oo");
    scan(fs, "cli/cmd_bot.oo");
    scan(fs, "registry/regs.oo");
    println("no_shell_proof: PASSED");
}
