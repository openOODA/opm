// # Extract, allow-list, and launch gate proofs
//
// Logline: Drive shipped member refuse, ar walk, fail-closed url allow-list, and launch gates.
//
// Setup: In-memory ar bytes. No fixtures. No HTTP. No dpkg.
//
// Beats:
//   1. ../evil members refuse. data.tar extracts. Missing magic is err magic.
//   2. https github.com and git@github.com allow. http, git://, fake userinfo, and suffix hosts deny.
//   3. Launch gate refuses yank, sha mismatch, and extra caps.

import "policy/allow.oo";
import "store/extract.oo";
import "launch/launch.oo";
import "store/tar.oo";

fn fail(msg: String) {
    println("FAIL " + msg);
    process_exit(1);
}

fn pad(s: String, n: Int) -> String {
    let mut out: String = s;
    while chars_len(out) < n {
        out = out + " ";
    }
    return out;
}

fn ar_one(name: String, body: String, size_s: String) -> String {
    let hdr: String = pad(name, 16) + pad("0", 12) + pad("0", 6) +
        pad("0", 6) + pad("644", 8) + pad(size_s, 10) + "`\n";
    let mut out: String = "!<arch>\n" + hdr + body;
    let n: Int = chars_len(body);
    if (n - (n / 2) * 2) == 1 {
        out = out + "\n";
    }
    return out;
}

pub fn main() {
    if pm_member_ok("../evil") { fail("dotdot"); }
    if pm_member_ok("/abs") { fail("abs"); }
    if pm_member_ok("preinst") { fail("preinst"); }
    if !pm_member_ok("data.txt") { fail("data"); }
    println("member");
    let ev: String = ar_one("../evil", "x", "1");
    if pm_ar_walk(ev) == "err path" {
        println("evil ar");
    } else {
        fail("evil ar");
    }
    let gd: String = ar_one("data.txt", "hi\n", "3");
    let w: String = pm_ar_walk(gd);
    if w == "ok hi\n" {
        println("good ar");
    } else {
        fail("good ar " + w);
    }
    if pm_ar_walk("nope") == "err magic" {
        println("magic");
    } else {
        fail("magic");
    }
    if pm_deb_extract(gd) == "err magic" {
        println("deb without data.tar");
    } else {
        fail("deb without data.tar");
    }
    if pm_deb_extract(ev) == "err path" {
        println("tar evil");
    } else {
        fail("tar evil");
    }
    if pm_deb_extract("nope") == "err magic" {
        println("blob magic");
    } else {
        fail("blob magic");
    }
    if !pm_url_allowed("", "https://github.com/openOODA/x.git") { fail("gh"); }
    if pm_url_allowed("", "https://evil.example/x.git") { fail("evil"); }
    if pm_url_allowed("fixtures/pm_ingest_repo\n", "fixtures/pm_ingest_repo") {
        println("allow");
    } else {
        fail("repo allow");
    }
    if pm_url_allowed("fixtures/pm_ingest_repo\n", "fixtures/pm_ingest_repo_evil") {
        fail("repoevil");
    }
    if !pm_url_allowed("fixtures/pm_ingest_repo.bundle\n", "fixtures/pm_ingest_repo.bundle") {
        fail("bundle");
    }
    if pm_url_allowed("", "https://registry.openooda.org/x") { fail("reg"); }
    if pm_url_allowed("", "https://notgithub.com/x.git") { fail("notgh"); }
    if pm_url_allowed("", "https://evil.example/github.com/x") { fail("embed"); }
    if !pm_url_allowed("", "git@github.com:org/x.git") { fail("gitat"); }
    if pm_url_allowed("", "https://github.com.evil/x") { fail("dotevil"); }
    if pm_url_allowed("", "http://github.com/openOODA/x.git") { fail("http"); }
    if pm_url_allowed("", "git://github.com/openOODA/x.git") { fail("gitscheme"); }
    if pm_url_allowed("", "https://github.com:x@evil.com/r.git") { fail("userinfo"); }
    if pm_url_allowed("", "https://github.com:@evil.com/r.git") { fail("emptyuser"); }
    if !pm_url_allowed("", "https://user:pass@github.com/org/x.git") { fail("authgh"); }
    if pm_url_allowed("gitlab.com\n", "https://gitlab.com.evil/x.git") { fail("pfxdot"); }
    if pm_url_allowed("https\n", "https://gitlab.com/x.git") { fail("httpspfx"); }
    if pm_url_allowed("", "https://evil.com#@github.com/r.git") { fail("hashat"); }
    if pm_url_allowed("", "https://evil.com?@github.com/r.git") { fail("queryat"); }
    println("deny");
    if pm_launch_gate("aa", "aa", 1, 1, false) == "ok" {
        println("launch ok");
    } else {
        fail("launch ok");
    }
    if pm_launch_gate("aa", "bb", 1, 1, false) == "err sha256 mismatch" {
        println("launch sha");
    } else {
        fail("launch sha");
    }
    if pm_launch_gate("aa", "aa", 1, 2, false) == "err caps" {
        println("launch caps");
    } else {
        fail("launch caps");
    }
    if pm_launch_gate("aa", "aa", 1, 1, true) == "err yank" {
        println("launch yank");
    } else {
        fail("launch yank");
    }
    if pm_launch_sink_ok("hello", "") == "ok" {
        println("launch sink clear");
    } else {
        fail("launch sink clear");
    }
    if pm_launch_sink_ok("PEER_VIRUS_PAYLOAD", "PEER_VIRUS_PAYLOAD") == "err untrusted" {
        println("launch sink marked");
    } else {
        fail("launch sink marked");
    }
    println("pm_extract_proof: PASSED");
}
