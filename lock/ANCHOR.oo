// # Opm Lockfile
//
// Logline: One lock format: v2 header plus sorted package lines.
//
// Setup: lock.oo is the line, sort, and hash layer.
//        v2.oo is replace, override, and local git pin on the same file.
//        There is not a second lock format.
//
// Beats:
//   1. Package lines are name@version#sha256#commit#CapName.
//   2. Header is v2 / oodac# / std#.
//   3. Fail-closed: every function returns Result[T, E] or asserts a precondition.

import "lock.oo";
import "v2.oo";
